CKB_RPC_URL=https://testnet.ckbapp.dev/
CKB_INDEXER_URL=https://testnet.ckbapp.dev/
CKB_GENESIS_HASH=0x10639e0895502b5688a6be8cf69460d76541bfa4821629d86d62ba0aae3f9606
OPERATOR_MANIFEST_PATH=deploy/manifests/dao-harvest-v2-testnet.json
# Required for scheduled and recurring payments after the V3 contracts are deployed.
OPERATOR_AUTOMATION_MANIFEST_PATH=deploy/manifests/operator-automation-testnet.json
# Optional JSON array of full recipient scripts that cannot be recovered from creation outputs.
OPERATOR_LOCK_RESOLUTIONS_PATH=operator-locks.json
OPERATOR_TRANSACTION_FEE=50000
OPERATOR_FEE_RATE_PER_KILOBYTE=1000
OPERATOR_MINIMUM_PROFIT_MARGIN=0
OPERATOR_CONFIRMATION_DEPTH=5
OPERATOR_HEALTH_PORT=9464
# The hosted service starts this watcher automatically with the `serve` command.
OPERATOR_WATCHER_ENABLED=true
OPERATOR_WATCHER_POLL_INTERVAL_MS=10000
OPERATOR_WATCHER_RETRY_BASE_MS=15000
OPERATOR_WATCHER_RETRY_MAXIMUM_MS=900000
OPERATOR_WATCHER_CONFIRMATION_TIMEOUT_MS=1800000
OPERATOR_WATCHER_MAXIMUM_JOBS_PER_SCAN=100
# Public identity used by the optional CKAutomata operator registry.
OPERATOR_NAME=Community Operator
OPERATOR_PUBLIC_URL=https://your-operator.example
CKAUTOMATA_API_URL=https://your-ckautomata-api.example
# Optional. Defaults to scheduled and recurring when the payment manifest is configured.
# Add dao-harvest only for permissionless fallback claiming. Preferred Harvest preparation is not
# yet provided by the standalone watcher.
OPERATOR_SERVICES=deadline,recurring
# Supply only at runtime. Never commit this value.
OPERATOR_PRIVATE_KEY=
